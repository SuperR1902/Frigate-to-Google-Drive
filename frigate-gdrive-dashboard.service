[Unit]
Description=Frigate to Google Drive uploader - status dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=frigate-uploader
WorkingDirectory=/opt/frigate-gdrive-uploader
ExecStart=/opt/frigate-gdrive-uploader/venv/bin/python3 /opt/frigate-gdrive-uploader/status_dashboard.py
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
