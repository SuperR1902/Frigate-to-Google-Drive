# --- Frigate ---
FRIGATE_URL=http://192.168.1.10:5000
# Comma-separated list of camera names to include. Leave empty for all cameras.
ONLY_CAMERAS=
# Skip events shorter than this many seconds (0 = no minimum)
MIN_EVENT_DURATION_SECONDS=0
# Only upload events Frigate has finished recording (recommended: true)
REQUIRE_FINISHED_EVENT=true

# --- Polling behavior ---
# How often to check Frigate for new events, in seconds
POLL_INTERVAL_SECONDS=30
# On startup, look back this many seconds for events that happened while
# the uploader was offline (default 6 hours)
STARTUP_LOOKBACK_SECONDS=21600

# --- Google Drive ---
# DRIVE_AUTH_MODE controls how the app authenticates to Drive:
#   service_account - default. Requires Google Workspace to actually upload
#                      files (service accounts have no storage quota of
#                      their own on personal @gmail.com accounts - you'll
#                      hit a "storageQuotaExceeded" 403 error otherwise).
#   oauth_user       - uploads using YOUR OWN Google account's storage quota
#                      via OAuth. Use this for personal Gmail accounts.
#                      See README for the one-time setup steps.
DRIVE_AUTH_MODE=service_account

SERVICE_ACCOUNT_FILE=credentials/service_account.json
# Only used when DRIVE_AUTH_MODE=oauth_user
OAUTH_TOKEN_FILE=credentials/oauth_token.json

# The Drive folder ID to upload into. For service_account mode, share this
# folder with the service account's email address. For oauth_user mode,
# it just needs to be a folder in your own Drive. Find the ID in the
# folder's URL.
DRIVE_ROOT_FOLDER_ID=
# If true, creates YYYY/MM/DD subfolders under DRIVE_ROOT_FOLDER_ID
DATE_SUBFOLDERS=true

# --- Timezone ---
# Used for filenames and YYYY/MM/DD Drive folder dates. Without this,
# timestamps default to UTC, which will be off by several hours from
# your actual local time. Use an IANA timezone name.
# Examples: Europe/Amsterdam, America/New_York, Asia/Tokyo
TZ=Europe/Amsterdam

# --- Local state ---
DB_PATH=db/events.db
TMP_DIR=tmp
LOG_FILE=logs/app.log
LOG_LEVEL=INFO
MAX_RETRY_ATTEMPTS=20
DB_RETENTION_DAYS=30
# Log file rotation - prevents unbounded disk growth over time.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# Updated every poll cycle - lets the status dashboard tell "process alive"
# apart from "process actually still working" (e.g. stuck/deadlocked).
HEARTBEAT_FILE=db/heartbeat.txt

# --- Drive retention (OFF by default - opt-in only) ---
# Automatically deletes uploaded files from Drive once they're older than
# N days and/or once total tracked storage exceeds a size cap (oldest
# first). Only files THIS TOOL uploaded and recorded locally are ever
# touched - there is no folder-wide sweep, so a lost/reset local database
# simply disables retention rather than risking deleting anything
# unexpected. Leave both at 0 to keep everything forever (the default).
DRIVE_RETENTION_MAX_AGE_DAYS=0
DRIVE_RETENTION_MAX_SIZE_GB=0
# How often to check/enforce retention, in seconds (default: hourly).
RETENTION_CHECK_INTERVAL_SECONDS=3600
# Set to true to log what WOULD be deleted without actually deleting
# anything - use this first to verify retention behaves as expected
# before trusting it to actually delete files.
DRIVE_RETENTION_DRY_RUN=false

# --- Status dashboard ---
# A small read-only web page showing upload stats, service health, and a
# log download button. Runs as its own service; no setup required beyond
# these settings. See README for details.
DASHBOARD_PORT=8080
# Leave both blank to allow open access (fine on a trusted home LAN).
# Set both to require HTTP Basic Auth if that matters for your network.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Must match the actual systemd unit name for the main uploader service -
# only change this if you renamed frigate-gdrive-uploader.service.
SERVICE_UNIT_NAME=frigate-gdrive-uploader
