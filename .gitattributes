# Force LF line endings for these files regardless of platform, so the
# shell script still works when cloned onto the Linux Proxmox host / LXC
# container after being committed from Windows.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.yml text eol=lf
*.env* text eol=lf
